# Réglages du back-office JUNO (/etc/juno-admin.env)
# Après modification : sudo systemctl restart juno-admin

# Notifications par e-mail à chaque nouveau message (facultatif).
# Renseigner un compte e-mail d'envoi (SMTP), par exemple celui de la messagerie du cabinet.
# SMTP_HOST=smtp.ionos.fr
# SMTP_PORT=587
# SMTP_USER=contact@juno-avocates.fr
# SMTP_PASS=mot-de-passe-de-la-boite
# SMTP_FROM=contact@juno-avocates.fr
# NOTIFY_TO=j.tellini@juno-avocates.fr
