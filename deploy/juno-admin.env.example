# Réglages du back-office JUNO (/etc/juno-admin.env)
# Les lignes e-mail sont écrites par : sudo bash /var/www/juno/deploy/configure-mail.sh
# Après modification à la main : sudo systemctl restart juno-admin

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=contact@juno-avocates.fr
# SMTP_PASS_B64=(mot de passe d'application, encodé en base64 par le script)
# SMTP_FROM="JUNO Avocat·es <contact@juno-avocates.fr>"
# NOTIFY_TO=contact@juno-avocates.fr
# SITE_URL=https://juno-avocates-paris.walautao.fr
# REPLY_BCC=  (facultatif : copie cachée des réponses, inutile avec Gmail)
